# CareerScope local configuration
#
# Copy this file to `.env` and edit only the values needed for your machine.
# The runtime validates required values at boot. `.env` is gitignored: never
# commit credentials, owner data, resume files or service URLs containing
# passwords.

NODE_ENV=development
DEPLOYMENT_ENVIRONMENT=development
APP_ORIGIN=http://localhost:5280
REGISTRATION_ENABLED=false
# Registration stays unavailable until owner/counsel approve policy text and
# the operator supplies its effective version IDs and HTTPS publication URLs.
LEGAL_TERMS_VERSION=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_VERSION=
LEGAL_PRIVACY_URL=
LEGAL_MARKETING_VERSION=

# Email one-time-code sign-in. Disabled by default for local test-selector use.
# Production startup requires this enabled, a separately generated >=32-byte
# HMAC key, and a Resend API key. Never put real values in this tracked example.
EMAIL_OTP_ENABLED=false
EMAIL_OTP_HMAC_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=CareerScope <noreply@careerscope.tech>

# Local dependencies from infra/compose.canonical.yml.
DATABASE_URL=postgresql://careerscope:change-me@127.0.0.1:55433/careerscope
REDIS_URL=redis://127.0.0.1:56479
QUEUE_REDIS_URL=redis://127.0.0.1:56480

# Search transport. BullMQ uses Redis queue.
SEARCH_QUEUE_TRANSPORT=bullmq
SEARCH_QUEUE_REDIS_URL=redis://127.0.0.1:56480

# --- Test Users (passwordless dev/test selector) -------------------------
# Local access only. Hosted testing requires proxy mode, HTTPS, a private
# TEST_PROXY_SECRET and the staging password hash in the proxy configuration.
# Explicit DEPLOYMENT_ENVIRONMENT=staging is required for proxy mode.
# Production must use DEPLOYMENT_ENVIRONMENT=production and TEST_ACCESS_MODE=disabled.
TEST_ACCESS_MODE=local

# Private encrypted resume storage. The key file must be owned by the API and
# kept outside source control. The production compose file supplies its paths.
RESUME_STORAGE_DIRECTORY=./data/private-objects
RESUME_STORAGE_KEY_FILE=./data/resume-storage.key

# Optional provider credentials. Leave empty to use keyless sources.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
RAPIDAPI_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
